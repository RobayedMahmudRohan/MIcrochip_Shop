# Microchip Shop — environment variable reference.
#
# Copy this file to `.env.local` for local development and fill in real
# values there. `.env.local` (and every other `.env*` file except this one)
# is already git-ignored — see .gitignore. Never commit real secrets.
#
# Nothing in this file is wired up yet — these are placeholders for
# configuration that later phases (database, auth, payments, etc.) will need.

# --- Application ---
# Public base URL of the app, used for absolute links and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (not connected yet) ---
# Connection string for the primary database.
DATABASE_URL=

# --- Authentication (not implemented yet) ---
# Secret used to sign/encrypt session tokens. Generate a long random value.
AUTH_SECRET=
# Base URL auth providers should redirect back to.
AUTH_URL=http://localhost:3000

# --- Payment provider (not implemented yet) ---
# Publishable/public key, safe to expose to the browser.
NEXT_PUBLIC_PAYMENT_PROVIDER_PUBLIC_KEY=
# Secret key, server-side only — never prefix with NEXT_PUBLIC_.
PAYMENT_PROVIDER_SECRET_KEY=

# --- External API (optional, if a third-party data source is added) ---
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=
